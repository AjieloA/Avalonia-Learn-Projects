<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:component.ViewModels"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="200"
        x:Class="component.Views.HomePage"
        x:DataType="vm:HomePageViewModel"
        Width="400"
        Height="200"
        Title="Home">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 10 0 0" Spacing="10">
        <Button Content="前往登录"
                Width="200"
                Height="50"
                Command="{Binding GoToLoginPageCommand}"
                HorizontalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                FontSize="18"
                Background="{StaticResource OrangeGradient}">
        </Button>
    </StackPanel>
</Window>