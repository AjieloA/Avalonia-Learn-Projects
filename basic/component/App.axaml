<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="component.App"
             xmlns:local="using:component"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
    <Application.Resources>
        <LinearGradientBrush x:Key="OrangeGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#FF5F6D" />
            <GradientStop Offset="1" Color="#FFC371" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SkyGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#C2FFD8" />
            <GradientStop Offset="1" Color="#465EFB" />
        </LinearGradientBrush>
    </Application.Resources>
</Application>